# === Telegram ===
# BotFather で取得したトークン
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# 管理者の Telegram user ID (数値)。@userinfobot などで確認できる。
ADMIN_TELEGRAM_ID=123456789

# 購入者がトラブル時に問い合わせる先 (@なしでも可)
SUPPORT_CONTACT=@anonxdev

# === Database ===
# SQLite (デフォルト)。PostgreSQL へ切り替える場合:
#   postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///shop.db

# === Security ===
# PayPay セッション暗号化キー。以下で生成する:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=

# 暗号化された PayPay セッションの保存先 (暗号化 JSON)
PAYPAY_SESSION_PATH=paypay_session.enc

# === PaymentProvider ===
# "mock" もしくは "paypay"
PAYMENT_PROVIDER=mock

# 購入者の支払い方法
#   link    = 購入者が送金リンクを作成し、Botが受け取る（既定）
#   request = Botが請求リンクを発行し、購入者が取引番号を送る

# PayPay通信だけを通すProxy（空なら直接接続）。Telegram通信は通らない。
# 日本のモバイル/住宅IP・固定(sticky)セッションのHTTP Proxyを推奨。
# 形式: http://ユーザー名:パスワード@ホスト:ポート
#  - パスワードに @ : / などが入る場合はURLエンコード（@ → %40）
#  - 認証付きSOCKS5はログイン時のChromiumが対応していないため不可
PAYPAY_PROXY=

# 注文有効時間 (秒)。デフォルト 600 = 10 分
ORDER_TTL_SECONDS=600

# PayPay一次保留時、購入者に解除を促してから自動再確認するまでの秒数 (デフォルト60秒)
HOLD_RECHECK_SECONDS=60

# ログレベル
LOG_LEVEL=INFO

# 任意: ショップに表示するリンクボタン（空ならボタン非表示）
SALES_CHANNEL=          # 販売チャンネル（@name か https://t.me/...）
TERMS_URL=              # 利用規約の全文リンク（https://...）
